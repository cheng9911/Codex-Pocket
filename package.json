{
  "name": "codex-pocket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/server/src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-timeout=30000 tests/*.test.ts",
    "verify:transport": "tsx scripts/verify-transport.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "pair": "tsx apps/server/src/index.ts --pair",
    "verify:vendor": "tsx scripts/verify-vendor.ts",
    "verify:controls": "tsx scripts/verify-controls.ts",
    "preview:test": "tsx scripts/preview-test.ts",
    "service:install": "tsx scripts/install-service.ts",
    "verify:features": "tsx scripts/verify-features.ts",
    "password:set": "tsx scripts/set-password.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "better-sqlite3": "13.2.0",
    "effect": "4.1.3",
    "express": "5.3.0",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "license": "MIT",
  "description": "A focused self-hosted mobile web controller for Codex",
  "repository": {
    "type": "git",
    "url": "https://github.com/cheng9911/Codex-Pocket.git"
  }
}
