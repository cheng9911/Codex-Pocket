# Keep listening on loopback when publishing through Cloudflare Tunnel.
POCKET_HOST=127.0.0.1
POCKET_PORT=4310
# POCKET_ORIGIN=https://pocket.example.com
# All directories by default on Linux, subject to the host user's filesystem permissions.
POCKET_ROOTS=/
# To restrict workspaces instead: POCKET_ROOTS=/absolute/path/to/your/projects
# POCKET_DATA_DIR=/absolute/path/outside/the/repository
# CODEX_BIN=/absolute/path/to/codex
# Password hash file; default is POCKET_DATA_DIR/auth.json. Set via npm run password:set.
# POCKET_AUTH_FILE=/absolute/path/outside/the/repository/auth.json

# Optional experimental desktop bridge; defaults to CODEX_HOME/ipc/ipc.sock.
# POCKET_DESKTOP_SOCKET=/home/your-user/.codex/ipc/ipc.sock
